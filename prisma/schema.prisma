datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// Enum untuk membedakan tipe konten
enum ContentType {
  MOVIE
  SERIES
}

// 1. TABEL UTAMA KONTEN (Movie atau Series)
model Content {
  id           String      @id @default(uuid())
  tmdbId       String
  type         ContentType
  title        String
  slug         String      @unique
  posterPath   String?     // ✅ Tambah
  backdropPath String?     // ✅ Tambah
  releaseDate  String?     // ✅ Tambah
  overview     String?     // ✅ Tambah
  genres       String[]
  tags         String[]    // ✅ Tambah ini
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  episodes     Episode[]
  movies       MovieData?
  views        ViewStats[]
  comments     Comment[]
  watchlists  Watchlist[]

  @@index([tmdbId])
}

// 2. TABEL KHUSUS MOVIE (Jika tipenya Movie, link streaming disimpan di sini)
model MovieData {
  id         String   @id @default(uuid())
  contentId  String   @unique
  videoUrl   String   // Link video streaming (.m3u8 / mp4)
  content    Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
}

// 3. TABEL EPISODE (Jika tipenya Series, link streaming diatur per episode)
model Episode {
  id         String   @id @default(uuid())
  contentId  String
  season     Int      @default(1)
  episodeNum Int
  videoUrl   String   // Link video streaming per episode
  createdAt  DateTime @default(now())

  content    Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  // Mencegah ada nomor episode yang sama dalam satu season di series yang sama
  @@unique([contentId, season, episodeNum])
}

// 4. TABEL STATISTIK VIEWS (Untuk Dashboard Real-time)
model ViewStats {
  id        String   @id @default(uuid())
  contentId String
  viewedAt  DateTime @default(now()) // Mencatat jam berapa ditonton buat grafik dashboard
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId, viewedAt])
}

// 5. TABEL KOMENTAR
model Comment {
  id        String   @id @default(uuid())
  contentId String
  username  String
  text      String
  createdAt DateTime @default(now())
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId])
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String   // ID User yang punya watchlist
  itemId    String   // ID Film atau Series-nya
  createdAt DateTime @default(now())

  content   Content  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId]) // Biar user gak bisa bookmark judul yang sama dua kali
}

// 6. TABEL USER (Scalable & Siap pakai Credentials maupun OAuth/Sosmed)
model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  password      String?   // Dibikin opsional (?) biar kalau ke depan lu tambah login via Google, user OAuth gak crash karena gak punya password
  image         String?   // Untuk simpan foto profil user
  role          Role      @default(USER) // Membedakan User biasa dengan Admin / VIP
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relasi ke tabel Watchlist (Satu user bisa punya banyak bookmark)
  watchlists    Watchlist[]
  
  // 💡 JALUR SCALABLE KE DEPAN:
  // Lu bisa tambah relasi baru di sini nanti tanpa ngerusak kode lama, contoh:
  // histories   WatchHistory[] 
  // isPremium   Boolean   @default(false)
}

enum Role {
  USER
  VIP
  ADMIN
}