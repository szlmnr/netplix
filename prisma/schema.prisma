datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// Enum untuk membedakan tipe konten
enum ContentType {
  MOVIE
  SERIES
}

// 1. TABEL UTAMA KONTEN (Movie atau Series)
model Content {
  id           String      @id @default(uuid())
  tmdbId       String
  type         ContentType
  title        String
  slug         String      @unique
  posterPath   String?     // ✅ Tambah
  backdropPath String?     // ✅ Tambah
  releaseDate  String?     // ✅ Tambah
  overview     String?     // ✅ Tambah
  genres       String[]
  tags         String[]    // ✅ Tambah ini
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  episodes     Episode[]
  movies       MovieData?
  views        ViewStats[]
  comments     Comment[]
  watchlists  Watchlist[]
  histories    WatchHistory[]

  @@index([tmdbId])
}

// 2. TABEL KHUSUS MOVIE (Jika tipenya Movie, link streaming disimpan di sini)
model MovieData {
  id         String   @id @default(uuid())
  contentId  String   @unique
  videoUrl   String   // Link video streaming (.m3u8 / mp4)
  content    Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
}

// 3. TABEL EPISODE (Jika tipenya Series, link streaming diatur per episode)
model Episode {
  id         String   @id @default(uuid())
  contentId  String
  season     Int      @default(1)
  episodeNum Int
  videoUrl   String   // Link video streaming per episode
  createdAt  DateTime @default(now())

  content    Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  // Mencegah ada nomor episode yang sama dalam satu season di series yang sama
  @@unique([contentId, season, episodeNum])
}

// 4. TABEL STATISTIK VIEWS (Untuk Dashboard Real-time)
model ViewStats {
  id        String   @id @default(uuid())
  contentId String
  viewedAt  DateTime @default(now()) // Mencatat jam berapa ditonton buat grafik dashboard
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId, viewedAt])
}

// 5. TABEL KOMENTAR
model Comment {
  id        String   @id @default(uuid())
  contentId String
  username  String
  text      String
  createdAt DateTime @default(now())
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId])
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String   
  itemId    String   
  createdAt DateTime @default(now())

  content   Content  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId]) 
}

model User {
  id        String    @id @default(uuid())
  username  String?   @unique // 🟩 Diubah dari name ke username + dibikin @unique biar gak duplikat
  email     String    @unique
  password  String?   
  image     String?   // Untuk simpan foto profil/avatar user
  role      Role      @default(USER) 
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relasi
  watchlists Watchlist[]
  histories  WatchHistory[] // 🟩 Mengaktifkan fitur history tontonan
}

enum Role {
  USER
  VIP
  ADMIN
}

// 🟩 MODEL BARU: Untuk Fitur Sejarah Tontonan
model WatchHistory {
  id        String   @id @default(cuid())
  userId    String
  itemId    String
  watchedAt DateTime @default(now()) // Kapan user nonton film ini

  content   Content  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId]) // Biar kalau nonton berulang kali, yang tercatat tetap update waktu nonton terakhirnya saja
}